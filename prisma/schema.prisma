generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  HR
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(HR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs                Job[]
  notes               Note[]
  statusChanges       StatusHistory[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // store only a hash, never the raw token
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  jobs Job[]
}

model Job {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  summary          String
  description      String          @db.Text
  responsibilities String          @db.Text
  requirements     String          @db.Text
  benefits         String?         @db.Text
  location         String
  type             JobType
  workplace        WorkplaceType   @default(ONSITE)
  experience       ExperienceLevel
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String          @default("USD")
  status           JobStatus       @default(DRAFT)
  featured         Boolean         @default(false)
  deadline         DateTime?
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  formId String?
  form   ApplicationForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  applications Application[]

  @@index([status, publishedAt])
  @@index([departmentId])
  @@index([type])
  @@index([location])
  @@index([formId])
}

model Application {
  id           String  @id @default(cuid())
  fullName     String
  email        String
  phone        String
  country      String
  city         String
  coverLetter  String? @db.Text
  linkedinUrl  String?
  portfolioUrl String?
  answers     Json?

  // CV metadata (the file lives in /storage/cvs, outside /public)
  cvOriginalName String
  cvStoredName   String @unique
  cvMimeType     String
  cvSize         Int

  consent   Boolean           @default(false)
  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Restrict: a job with applications can't be deleted. Close it instead.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  notes   Note[]
  history StatusHistory[]

  // Prevents the same person applying twice to the same job
  @@unique([jobId, email])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([applicationId])
}

model StatusHistory {
  id         String             @id @default(cuid())
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  createdAt  DateTime           @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

model ApplicationForm {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  fields      Json
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}